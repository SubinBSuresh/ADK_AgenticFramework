<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Automotive ADK Agentic Framework"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp" />

    <Button
        android:id="@+id/btnComfortTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Comfort Agent (Temp 70°F)" />

    <Button
        android:id="@+id/btnMediaTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Media Agent (Play Jazz)" />

    <Button
        android:id="@+id/btnProductivityTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Productivity Agent (Calendar)" />

    <Button
        android:id="@+id/btnMultiDomainTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Multi-Domain Route (Temp &amp; Music)" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#1E1E1E"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="[Logs &amp; Output will appear here...]" />
    </ScrollView>

</LinearLayout>